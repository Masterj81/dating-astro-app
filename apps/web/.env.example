# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend (email)
RESEND_API_KEY=re_your-api-key
# From-address is a mailbox identifier bound to MX/SPF/DKIM records — it does
# not move in lockstep with the public domain. Keep on astrodatingapp.com
# until junosynastry.com mailboxes + email auth are provisioned.
EMAIL_FROM=JUNO <noreply@junosynastry.com>

# Site — canonical public domain (apex junosynastry.com must 301 to www)
NEXT_PUBLIC_SITE_URL=https://www.junosynastry.com

# --- Birth city autocomplete -------------------------------------------------
# There is deliberately NO NEXT_PUBLIC_GEOAPIFY_API_KEY here. The provider key
# lives only in the suggest-birth-cities edge function; this client calls that
# endpoint. A key in a bundle is public, and a public key on a 3,000/day free
# tier is someone else's off switch for our onboarding.
