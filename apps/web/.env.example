# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend (email)
RESEND_API_KEY=re_your-api-key
# From-address is a mailbox identifier bound to MX/SPF/DKIM records — it does
# not move in lockstep with the public domain. Keep on astrodatingapp.com
# until junosynastry.com mailboxes + email auth are provisioned.
EMAIL_FROM=JUNO <noreply@junosynastry.com>

# Site — canonical public domain (apex junosynastry.com must 301 to www)
NEXT_PUBLIC_SITE_URL=https://www.junosynastry.com

# --- Birth city autocomplete -------------------------------------------------
# There is deliberately NO NEXT_PUBLIC_GEOAPIFY_API_KEY here. The provider key
# lives only in the suggest-birth-cities edge function; this client calls that
# endpoint. A key in a bundle is public, and a public key on a 3,000/day free
# tier is someone else's off switch for our onboarding.

# --- Contact form hardening (JUNO-07, 2026-09-17) ----------------------------
# Turnstile anti-automation. The SECRET stays server-side only; the SITE key
# is public in the client bundle. WITHOUT these two variables the contact
# form is DISABLED (server refuses with 503, client shows an honest notice) —
# production must never silently run permissive.
# Official Cloudflare TEST values for local development:
#   site key   1x00000000000000000000AA  (always passes)
#   secret key 1x0000000000000000000000000000000AA  (always passes)
#   (2x… variants always BLOCK — useful to exercise the failure paths)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# HMAC key for the durable per-origin / per-address contact rate limits
# (check_edge_rate_limit buckets). ≥ 32 chars, server-only: the buckets store
# irreversibly keyed digests, never a raw email or IP. Missing/short → the
# contact route FAILS CLOSED (503) rather than keying unsalted digests.
CONTACT_HASH_SECRET=generate-a-random-32-plus-character-secret
