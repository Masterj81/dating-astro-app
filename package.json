{
  "name": "astro-dating-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@10.8.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:mobile": "npm run start --workspace=@astro/mobile",
    "dev:web": "npm run dev --workspace=@astro/web",
    "build:mobile:android": "npm run build:android --workspace=@astro/mobile",
    "build:mobile:ios": "npm run build:ios --workspace=@astro/mobile",
    "build:web": "npm run build --workspace=@astro/web",
    "validate:web:locales": "node scripts/validate-web-locales.js",
    "validate:mobile:locales": "node scripts/validate-mobile-locales.js",
    "validate:mobile:i18n-usage": "node scripts/validate-mobile-i18n-usage.mjs",
    "validate:premium-gating": "node scripts/validate-premium-gating.mjs",
    "validate:premium-data-sources": "node scripts/validate-premium-data-sources.mjs",
    "validate:coach-content": "node scripts/validate-coach-content.mjs",
    "validate:web-onboarding": "node scripts/validate-web-onboarding.mjs",
    "validate:email-templates": "node scripts/validate-email-templates.mjs",
    "validate:locale-contract": "node scripts/validate-locale-contract.mjs",
    "validate:retention-guards": "node scripts/validate-mobile-retention-guards.mjs",
    "validate:natal-integrity": "node scripts/validate-natal-integrity.mjs",
    "validate:design-tokens": "node scripts/validate-design-tokens.mjs",
    "validate:profile-reads": "node scripts/validate-profile-reads.mjs",
    "validate:tarot-content": "node scripts/validate-tarot-content.mjs",
    "build:edge-astrology": "node scripts/build-edge-astrology.mjs",
    "validate:edge-astrology": "node scripts/build-edge-astrology.mjs --check",
    "build:edge-tarot": "node scripts/build-edge-tarot.mjs",
    "validate:edge-tarot": "node scripts/build-edge-tarot.mjs --check",
    "validate:m1a-pipeline": "node scripts/validate-m1a-pipeline.mjs",
    "validate:m2-pipeline": "node scripts/validate-m2-pipeline.mjs",
    "validate:chart-privacy": "npm run test --workspace=@astro/shared -- src/astrology/__tests__/chart-payload-privacy.test.ts",
    "validate:edge-security": "npm run test --workspace=@astro/shared -- src/security",
    "validate:rls-contract": "node scripts/validate-rls-contract.mjs",
    "validate:migration-history": "node scripts/validate-migration-history.mjs",
    "validate:android-security-config": "node scripts/validate-android-security-config.mjs",
    "validate:web-session-csp": "node scripts/validate-web-session-csp.mjs",
    "validate:ci-security": "node scripts/validate-ci-security.mjs",
    "audit:web-runtime": "node scripts/audit-web-runtime.mjs",
    "validate:pwa-kill-switch": "node scripts/validate-pwa-kill-switch.mjs",
    "check:android-adoption-gate": "node scripts/check-android-adoption-gate.mjs",
    "test:pwa-legacy-recovery": "node scripts/pwa-legacy-recovery.mjs",
    "validate:repo-hygiene": "node scripts/validate-repo-hygiene.mjs",
    "validate:cron-secrets": "node scripts/validate-cron-secrets.mjs",
    "validate:media-purge": "node scripts/validate-media-purge.mjs",
    "validate:orphan-purge": "node scripts/validate-orphan-purge.mjs",
    "check:unsubscribe-legacy-key": "node scripts/check-unsubscribe-legacy-key.mjs",
    "validate:engine-contract": "npm run test --workspace=@astro/shared -- src/astrology/__tests__/engine-contract.test.ts",
    "validate:locales": "npm run validate:web:locales && npm run validate:mobile:locales && npm run validate:mobile:i18n-usage && npm run validate:locale-contract",
    "check:store-metadata": "node scripts/check-store-metadata.mjs",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test --continue",
    "test:e2e": "maestro test .maestro/",
    "test:e2e:studio": "maestro studio",
    "clean": "turbo clean && npx rimraf node_modules apps/*/node_modules packages/*/node_modules",
    "validate:astro-portal": "node scripts/validate-astro-portal.mjs"
  },
  "devDependencies": {
    "rimraf": "^6.0.1",
    "turbo": "^2.0.0"
  },
  "overrides": {
    "@supabase/supabase-js": "^2.93.3",
    "typescript": "^5.9.2",
    "expo-constants": "~18.0.13",
    "expo-asset": "~12.0.12"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "sharp": "^0.35.4"
  }
}
