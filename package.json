{
  "name": "astro-dating-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@10.8.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:mobile": "npm run start --workspace=@astro/mobile",
    "dev:web": "npm run dev --workspace=@astro/web",
    "build:mobile:android": "npm run build:android --workspace=@astro/mobile",
    "build:mobile:ios": "npm run build:ios --workspace=@astro/mobile",
    "build:web": "npm run build --workspace=@astro/web",
    "validate:web:locales": "node scripts/validate-web-locales.js",
    "validate:mobile:locales": "node scripts/validate-mobile-locales.js",
    "validate:mobile:i18n-usage": "node scripts/validate-mobile-i18n-usage.mjs",
    "validate:premium-gating": "node scripts/validate-premium-gating.mjs",
    "validate:coach-content": "node scripts/validate-coach-content.mjs",
    "validate:web-onboarding": "node scripts/validate-web-onboarding.mjs",
    "validate:email-templates": "node scripts/validate-email-templates.mjs",
    "validate:locale-contract": "node scripts/validate-locale-contract.mjs",
    "validate:retention-guards": "node scripts/validate-mobile-retention-guards.mjs",
    "validate:natal-integrity": "node scripts/validate-natal-integrity.mjs",
    "validate:locales": "npm run validate:web:locales && npm run validate:mobile:locales && npm run validate:mobile:i18n-usage && npm run validate:locale-contract",
    "check:store-metadata": "node scripts/check-store-metadata.mjs",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test --continue",
    "test:e2e": "maestro test .maestro/",
    "test:e2e:studio": "maestro studio",
    "clean": "turbo clean && npx rimraf node_modules apps/*/node_modules packages/*/node_modules"
  },
  "devDependencies": {
    "rimraf": "^6.0.1",
    "turbo": "^2.0.0"
  },
  "overrides": {
    "@supabase/supabase-js": "^2.93.3",
    "typescript": "^5.9.2",
    "expo-constants": "~18.0.13",
    "expo-asset": "~12.0.12"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.81.0",
    "@google/generative-ai": "^0.24.1"
  }
}
