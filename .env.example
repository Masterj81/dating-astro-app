# Supabase
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# RevenueCat (In-App Purchases - iOS/Android)
EXPO_PUBLIC_REVENUECAT_API_KEY_IOS=
EXPO_PUBLIC_REVENUECAT_API_KEY_ANDROID=

# --- Edge function environment ----------------------------------------------
# Read by the shared origin allowlist (supabase/functions/_shared/cors.ts).
#
# ONLY the exact value `development` widens CORS and the redirect allowlist to
# include localhost. Absent, misspelled, or anything else resolves to the
# PRODUCTION list — the safe direction. Before 7 Sep 2026 the test was
# `=== 'production'`, so an unset variable allowed localhost to read
# cross-origin responses with the caller's credentials, and to receive the
# post-payment redirect. Leave this UNSET in production.
#   supabase secrets set ENVIRONMENT=development   # local only
ENVIRONMENT=

# Stripe (Web Payments)
# Get these from https://dashboard.stripe.com
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
EXPO_PUBLIC_STRIPE_PRICE_CELESTIAL_MONTHLY=price_...
EXPO_PUBLIC_STRIPE_PRICE_CELESTIAL_YEARLY=price_...
EXPO_PUBLIC_STRIPE_PRICE_COSMIC_MONTHLY=price_...
EXPO_PUBLIC_STRIPE_PRICE_COSMIC_YEARLY=price_...

# Server-side price ids, read by create-checkout-session. Same values as the
# EXPO_PUBLIC_* pair above; declared separately because the function validates
# against ITS OWN list rather than one the client could influence.
#   supabase secrets set STRIPE_PRICE_CELESTIAL_MONTHLY=price_... (etc.)
STRIPE_PRICE_CELESTIAL_MONTHLY=
STRIPE_PRICE_CELESTIAL_YEARLY=
STRIPE_PRICE_COSMIC_MONTHLY=
STRIPE_PRICE_COSMIC_YEARLY=

# The automatic annual discount. SERVER-ONLY, and that is the fix, not a
# preference: this used to be EXPO_PUBLIC_STRIPE_ANNUAL_COUPON_ID, published in
# both bundles, and the client chose whether to send it. The server applied
# whatever it received without checking it against the plan, so a MONTHLY price
# could be paired with the ANNUAL coupon — or with any coupon in the Stripe
# account. The discount is now derived from the validated price id.
# See docs/security-audit-2026-09-07.md, JUNO-03.
#   supabase secrets set STRIPE_ANNUAL_COUPON_ID=...
STRIPE_ANNUAL_COUPON_ID=

# Edge Function URL (for push notifications via pg_net)
# In production, set this to your deployed Supabase edge function URL
# e.g., https://your-project.supabase.co/functions/v1/send-notification
EDGE_FUNCTION_URL=

# Resend (Production Email)
# RESEND_API_KEY — set as a Supabase edge function secret: supabase secrets set RESEND_API_KEY=re_...
# RESEND_SMTP_KEY — same key, used for SMTP auth in Supabase Dashboard > Auth > SMTP
# EMAIL_FROM — sender address. Mailbox stays on astrodatingapp.com (bound to
# MX/SPF/DKIM); only the display name is the JUNO brand.
RESEND_API_KEY=
RESEND_SMTP_KEY=
EMAIL_FROM=JUNO <noreply@astrodatingapp.com>

# Testing (never set to true in production)
EXPO_PUBLIC_FORCE_PREMIUM=false

# EAS Build
APP_ENV=development

# --- Birth city autocomplete -------------------------------------------------
# Geoapify Address Autocomplete, used ONLY by the suggest-birth-cities edge
# function. Deliberately NOT NEXT_PUBLIC_ or EXPO_PUBLIC_: neither provider can
# meaningfully restrict a key shipped in an app bundle (Geoapify offers a
# User-Agent substring match; LocationIQ states the referrer "can be spoofed"),
# and on a 3,000 credit/day free tier a stolen key is a denial of service
# against our own onboarding. Set it with:
#   supabase secrets set GEOAPIFY_API_KEY=...
# Restrict the key in the Geoapify console to this project's egress where
# possible. See docs/birth-city-autocomplete-provider-2026-09.md.
GEOAPIFY_API_KEY=
