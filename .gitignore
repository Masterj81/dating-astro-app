marketingagent/evolution-state.json
marketingagent/memory.json
marketingagent/posts.json
marketingagent/schedule.json
marketingagent/video-scripts.json
marketingagent/training-feedback.json
marketingagent/tiktok-analytics.json

# Stray root artifacts — expo / tsc run from the monorepo root drops these
# stubs; the real files live in apps/mobile/ and tsconfig.base.json. Anchored
# to the root so they never shadow apps/mobile/app.json etc.
/app.json
/tsconfig.json

# Local research / release notes kept outside the repo.
#
# `/BigAd/` is 393 MB on disk. The rules below used to start at
# `/BigAd/docs/`, so everything AROUND docs/ was still eligible for
# `git add .` — and git cannot re-include a file whose parent directory is
# excluded, which is why this ignores `/BigAd/*` and then walks back down to
# the two guides rather than ignoring `/BigAd/` outright.
/BigAd/*
!/BigAd/docs/
/BigAd/docs/*
!/BigAd/docs/user-guide.md
!/BigAd/docs/pricing-guide.md
/Release-Checklist-48h.doc

# Local working directories and business data that have no reason to be in a
# git history. The spreadsheets are inventory pricing and a WooCommerce stock
# export — nothing in JUNO reads them, and a commit is permanent in a way a
# later `git rm` is not. Same list already excluded from the EAS build archive
# in apps/mobile/.easignore, for the same reasons.
/.tmp/
/.tools/
/*.xlsx

# JUNO-20 of docs/security-audit-2026-09-07.md — no archives in a route folder.
#
# `apps/mobile/app/appaD.zip` was a 147 KB snapshot of the whole expo-router
# tree taken in March 2026: 58 route files including `(tabs)/matches.tsx` and
# `match/[id].tsx`, from the `matches` model retired in May 2026, and predating
# every hardening in this repository. It carried no secret — that was verified
# against eleven credential patterns before it was removed, which is why the
# git history was NOT rewritten. The risk was resurrection: a backup sitting in
# the routing directory invites somebody to restore it.
#
# Scoped to route folders on purpose. Archives elsewhere in the repository are
# legitimate (store assets, build outputs) and are not the subject of this rule.
# scripts/validate-repo-hygiene.mjs fails the build if one is committed anyway,
# because .gitignore does not stop `git add -f`.
apps/*/app/**/*.zip
apps/*/app/**/*.tar
apps/*/app/**/*.tar.gz
apps/*/app/**/*.tgz
apps/*/app/**/*.7z
apps/*/app/**/*.rar
