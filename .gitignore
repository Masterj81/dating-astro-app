.claude/

# Monorepo workspaces
apps/*/.next/
apps/*/.expo/
apps/*/node_modules/
apps/*/.env*.local
packages/*/node_modules/
packages/*/dist/

# Root env
.env.local

# Vercel
.vercel

# Turbo
.turbo/

# Maestro test credentials
.maestro/.env

# Local dev logs & crash dumps
*.log
*.stackdump

# Local build / tooling scratch dirs
.gradle-local/
.maestro/logs/
tmp-screenshots/
.tmp_pypdf/

# Marketing agent — generated image artifacts (not source code)
marketingagent/generated-images/

# Marketing agent — runtime state mutated by the agent at run time (not source)
marketingagent/evolution-state.json
marketingagent/memory.json
marketingagent/posts.json
marketingagent/schedule.json
marketingagent/video-scripts.json
marketingagent/training-feedback.json

# Stray root artifacts — expo / tsc run from the monorepo root drops these
# stubs; the real files live in apps/mobile/ and tsconfig.base.json. Anchored
# to the root so they never shadow apps/mobile/app.json etc.
/app.json
/tsconfig.json

# Local research / release notes kept outside the repo
/BigAd/docs/
!/BigAd/docs/
/BigAd/docs/*
!/BigAd/docs/user-guide.md
!/BigAd/docs/pricing-guide.md
/Release-Checklist-48h.doc
