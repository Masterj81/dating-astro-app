# --- Required for content generation ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Required for publishing via Blotato (npm run post / dashboard / blotato-schedule) ---
BLOTATO_API_KEY=your-blotato-api-key
BLOTATO_FB_ACCOUNT_ID=your-blotato-facebook-account-id
BLOTATO_IG_ACCOUNT_ID=your-blotato-instagram-account-id
BLOTATO_FB_PAGE_ID=your-facebook-page-id

# --- Optional: image generation (falls back to Pollinations.ai if unset) ---
GEMINI_API_KEY=your-gemini-api-key
# GOOGLE_API_KEY is also accepted; if both are set, GEMINI_API_KEY wins.
# GOOGLE_API_KEY=your-google-api-key

# --- Required when posting images to Blotato (uploads to Supabase Storage first) ---
# and required for npm run schedule-server (server-side pg_cron publishing).
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Either of these also works for schedule-server.ts:
# EXPO_PUBLIC_SUPABASE_URL=...
# NEXT_PUBLIC_SUPABASE_URL=...
